<UserControl x:Class="GamepadTester.GamepadTesterSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16"
                    MaxWidth="720"
                    HorizontalAlignment="Left"
                    TextElement.Foreground="{DynamicResource TextBrush}">
            <TextBlock Text="{DynamicResource LOCGT_RetirementHeadline}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />
            <TextBlock Text="{DynamicResource LOCGT_RetirementBody}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />
            <Border Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource GlyphBrush}"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,0,12">
                <TextBlock Text="{DynamicResource LOCGT_RetirementConflict}"
                           TextWrapping="Wrap"
                           FontWeight="SemiBold" />
            </Border>
            <TextBlock Text="{DynamicResource LOCGT_RetirementSteps}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <TextBlock x:Name="StatusText"
                       TextWrapping="Wrap"
                       Opacity="0.86"
                       Margin="0,0,0,16" />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="InstallButton"
                        Content="{DynamicResource LOCGT_RetirementInstallControllerManager}"
                        MinWidth="220"
                        MinHeight="36"
                        Margin="0,0,8,0"
                        Click="InstallControllerManager" />
                <Button x:Name="UninstallButton"
                        Content="{DynamicResource LOCGT_RetirementUninstallThis}"
                        MinWidth="220"
                        MinHeight="36"
                        Click="UninstallGamepadTester" />
            </StackPanel>
            <TextBlock Text="{DynamicResource LOCGT_RetirementManualUninstallHint}"
                       TextWrapping="Wrap"
                       Opacity="0.72"
                       Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
